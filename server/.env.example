# Server Port
PORT=3000

# Environment Mode (production / development)
NODE_ENV=production

# JWT Authentication Secret (Use a strong random string)
JWT_SECRET=your_jwt_secret_key_here

# Allowed CORS Origins (comma-separated origins, or * for all)
ORIGINS=*

# Set to "true" ONLY if accessing your site via HTTPS with SSL certificate.
# Keep "false" when accessing via HTTP (e.g. direct EC2 Public IP: http://<ec2-ip>)
COOKIE_SECURE=false

# MongoDB Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/builderai

# OpenRouter AI Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
AI_MAX_CONCURRENCY=6
